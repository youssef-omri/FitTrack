<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/ivDropdownExerciseThumb"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_exercise_thumb"
        android:clipToOutline="true"
        android:contentDescription="Exercise thumbnail"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_fitness_center" />

    <TextView
        android:id="@+id/tvDropdownExerciseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
